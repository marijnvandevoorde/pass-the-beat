# sv-deploy config: ships origin/main to the cluster sv-oke.
# See ../../Oracle/deploy/README.md. Run: scripts/deploy.sh (or scripts/deploy.sh --check).
APP=pass-the-beat
# name|build context|Dockerfile|extra buildx args
IMAGES='
pass-the-beat|.|Dockerfile|
'
# 0 replicas at rest: pass-the-aux scales it to 1 while it analyses, so a deploy only sets
# the image. It has no public hostname; its readiness probe checks /healthz.
TARGETS="apps/pass-the-beat/pass-the-beat=pass-the-beat"
SMOKE_URLS=""
MANIFESTS="k8s/apps/tier2/stacks.py"
