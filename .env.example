# pass-the-beat sidecar — standalone deployment config.
#
# Copy to `.env`. Everything is optional.
#   cp .env.example .env

# Directory on the host that holds the audio files, mounted read-only at
# /music. Only POST /analyze (by path) uses it; POST /analyze-audio takes
# the bytes in the request body instead.
MUSIC_DIR=./music

# Host port the service is published on. The container always listens
# on 8000 internally.
# PASS_THE_BEAT_HOST_PORT=8000

# beat-this model checkpoint to load. "final0" is the default released
# model and is baked into the image at build time. Changing this
# triggers a checkpoint download on first request.
# BEATTHIS_CHECKPOINT=final0

# Torch device for the beat-this model. "cpu" works everywhere; set to
# "cuda" if you have an NVIDIA GPU AND rebuild the image against a CUDA
# torch wheel (the default Dockerfile installs the CPU-only build).
# BEATTHIS_DEVICE=cpu
